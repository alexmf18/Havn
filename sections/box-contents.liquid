{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<section
  class="box-contents section section--{{ section.settings.section_width }} spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --box-contents-surface: {{ section.settings.card_background_color }};
    --box-contents-border: {{ section.settings.card_border_color }};
    --box-contents-heading: {{ section.settings.heading_color }};
    --box-contents-title: {{ section.settings.item_title_color }};
    --box-contents-text: {{ section.settings.item_text_color }};
    --box-contents-gap: {{ section.settings.column_gap }}px;
    --box-contents-heading-size: {{ section.settings.heading_size }}px;
    --box-contents-title-size: {{ section.settings.item_title_size }}px;
    --box-contents-text-size: {{ section.settings.item_text_size }}px;
    --box-contents-card-radius: {{ section.settings.card_border_radius }}px;
    --box-contents-card-padding: {{ section.settings.card_padding }}px;
    --box-contents-card-border-width: {{ section.settings.card_border_width }}px;
  "
>
  {%- if section.settings.heading != blank -%}
    <h2 class="box-contents__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  <div class="box-contents__grid">
    {%- for block in section.blocks -%}
      <article
        class="box-contents__item"
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.title != blank -%}
          <h3 class="box-contents__title">{{ block.settings.title | escape }}</h3>
        {%- endif -%}

        {%- if block.settings.text != blank -%}
          <div class="box-contents__text">
            {{ block.settings.text }}
          </div>
        {%- endif -%}
      </article>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .box-contents {
    background: var(--color-background, transparent);
  }

  .box-contents__heading {
    margin: 0 0 2.4rem;
    color: var(--box-contents-heading, #f1eefa);
    font-family: var(--font-primary--family);
    font-size: var(--box-contents-heading-size);
    font-style: var(--font-primary--style);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.1;
  }

  .box-contents__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--box-contents-gap);
  }

  .box-contents__item {
    min-width: 0;
    padding: var(--box-contents-card-padding);
    border: var(--box-contents-card-border-width) dashed var(--box-contents-border, rgb(155 146 184 / 35%));
    border-radius: var(--box-contents-card-radius);
    background: var(--box-contents-surface, transparent);
  }

  .box-contents__title {
    margin: 0;
    color: var(--box-contents-title, #f1eefa);
    font-family: var(--font-accent--family);
    font-size: var(--box-contents-title-size);
    font-style: var(--font-accent--style);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.25;
  }

  .box-contents__text {
    margin-block-start: 0.8rem;
    color: var(--box-contents-text, #9b92b8);
    font-size: var(--box-contents-text-size);
    line-height: 1.45;
  }

  .box-contents__text > * {
    margin: 0;
  }

  .box-contents__text > * + * {
    margin-block-start: 0.7rem;
  }

  @media screen and (max-width: 989px) {
    .box-contents__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 599px) {
    .box-contents__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contenido de la caja",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Elemento",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titulo",
          "default": "Consola R36 Ultra"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "default": "<p>Con bateria de 3 000 mAh puesta</p>"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titulo",
      "default": "En la caja"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho",
      "options": [
        {
          "value": "page-width",
          "label": "Pagina"
        },
        {
          "value": "full-width",
          "label": "Completo"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#1B1533"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color de titulo",
      "default": "#F1EEFA"
    },
    {
      "type": "color",
      "id": "item_title_color",
      "label": "Color de titulo de elemento",
      "default": "#F1EEFA"
    },
    {
      "type": "color",
      "id": "item_text_color",
      "label": "Color de texto",
      "default": "#9B92B8"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Fondo de tarjeta",
      "alpha": true,
      "default": "#241C4000"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Color de borde",
      "alpha": true,
      "default": "#9B92B859"
    },
    {
      "type": "header",
      "content": "Tipografia"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamano de titulo",
      "min": 24,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "item_title_size",
      "label": "Tamano de titulo de elemento",
      "min": 13,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "item_text_size",
      "label": "Tamano de texto",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Tarjetas"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Separacion",
      "min": 8,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Relleno",
      "min": 12,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_border_width",
      "label": "Grosor de borde",
      "min": 0,
      "max": 3,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Radio de borde",
      "min": 0,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Superior",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Inferior",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Contenido de la caja",
      "category": "Texto",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "title": "Consola R36 Ultra",
            "text": "<p>Con bateria de 3 000 mAh puesta</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "microSD de 64 GB",
            "text": "<p>Cargada y ordenada por consola</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Cable USB-C",
            "text": "<p>Carga completa en 2 h</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Guia en espanol",
            "text": "<p>Una hoja. No hace falta mas</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
