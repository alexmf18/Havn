{% liquid
  assign console_blocks = section.blocks | where: 'type', 'console'
  assign stat_blocks = section.blocks | where: 'type', 'stat'
  assign image_resolution = section.settings.image_resolution | plus: 0
  assign description_image = section.settings.image

  if description_image == blank and product.featured_image != blank
    assign description_image = product.featured_image
  endif

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<section
  class="console-description section section--{{ section.settings.section_width }} spacing-style console-description--image-{{ section.settings.image_position }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --console-description-surface: {{ section.settings.surface_color }};
    --console-description-text: {{ section.settings.text_color }};
    --console-description-muted: {{ section.settings.muted_color }};
    --console-description-heading: {{ section.settings.heading_color }};
    --console-description-accent: {{ section.settings.accent_color }};
    --console-description-chip-bg: {{ section.settings.chip_background_color }};
    --console-description-chip-active-bg: {{ section.settings.chip_active_background_color }};
    --console-description-divider: {{ section.settings.divider_color }};
    --console-description-image-width: {{ section.settings.image_width }}%;
    --console-description-gap: {{ section.settings.column_gap }}px;
    --console-description-heading-size: {{ section.settings.heading_size }}px;
    --console-description-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --console-description-text-size: {{ section.settings.text_size }}px;
    --console-description-chip-size: {{ section.settings.chip_text_size }}px;
    --console-description-stat-size: {{ section.settings.stat_value_size }}px;
    --console-description-image-fit: {{ section.settings.image_fit }};
    --console-description-image-ratio: {{ section.settings.image_ratio }};
    --console-description-image-max-height: {{ section.settings.image_max_height }}px;
    --console-description-image-background: {{ section.settings.image_background_color }};
    --console-description-image-radius: {{ section.settings.image_border_radius }}px;
    --console-description-image-border-width: {{ section.settings.image_border_width }}px;
    --console-description-image-border: {{ section.settings.image_border_color }};
  "
>
  <div class="console-description__inner">
    <div class="console-description__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="console-description__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="console-description__text">
          {{ section.settings.text }}
        </div>
      {%- endif -%}

      {%- if console_blocks.size > 0 -%}
        <div
          class="console-description__chips"
          aria-label="{{ section.settings.console_list_label | escape }}"
        >
          {%- for block in console_blocks -%}
            <span
              class="console-description__chip{% if block.settings.highlight %} console-description__chip--highlight{% endif %}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.name | escape }}
            </span>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if stat_blocks.size > 0 -%}
        <div class="console-description__stats">
          {%- for block in stat_blocks -%}
            <div
              class="console-description__stat"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.value != blank -%}
                <p class="console-description__stat-value">{{ block.settings.value | escape }}</p>
              {%- endif -%}

              {%- if block.settings.label != blank -%}
                <p class="console-description__stat-label">{{ block.settings.label | escape }}</p>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <figure class="console-description__media">
      {%- if description_image != blank -%}
        {{
          description_image
          | image_url: width: image_resolution
          | image_tag:
            widths: '360, 533, 720, 900, 1200, 1600, 2048, 2400',
            sizes: '(min-width: 990px) 42vw, 100vw',
            alt: description_image.alt,
            loading: 'lazy',
            class: 'console-description__image'
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'console-description__image console-description__image--placeholder' }}
      {%- endif -%}

      {%- if section.settings.caption != blank -%}
        <figcaption class="console-description__caption">{{ section.settings.caption | escape }}</figcaption>
      {%- endif -%}
    </figure>
  </div>
</section>

{% stylesheet %}
  .console-description {
    background: var(--color-background, transparent);
    color: var(--console-description-text, #f1eefa);
  }

  .console-description__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, var(--console-description-image-width));
    grid-template-areas: 'content media';
    gap: var(--console-description-gap);
    align-items: center;
    background: var(--console-description-surface, transparent);
  }

  .console-description--image-left .console-description__inner {
    grid-template-columns: minmax(260px, var(--console-description-image-width)) minmax(0, 1fr);
    grid-template-areas: 'media content';
  }

  .console-description__content {
    grid-area: content;
    min-width: 0;
  }

  .console-description__heading {
    max-width: 11em;
    margin: 0;
    color: var(--console-description-heading, #f1eefa);
    font-family: var(--font-primary--family);
    font-size: var(--console-description-heading-size);
    font-style: var(--font-primary--style);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.08;
  }

  .console-description__text {
    max-width: 42rem;
    margin-block-start: 1.8rem;
    color: var(--console-description-muted, #9b92b8);
    font-family: var(--font-body--family);
    font-size: var(--console-description-text-size);
    line-height: 1.55;
  }

  .console-description__text > * {
    margin: 0;
  }

  .console-description__text > * + * {
    margin-block-start: 0.8rem;
  }

  .console-description__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-block-start: 3.2rem;
  }

  .console-description__chip {
    display: inline-flex;
    align-items: center;
    min-height: 3.2rem;
    padding: 0.5rem 1.2rem;
    border: 1px solid var(--console-description-accent, #4cc9f0);
    border-radius: 0.6rem;
    background: var(--console-description-chip-bg, transparent);
    color: var(--console-description-accent, #4cc9f0);
    font-family: var(--font-accent--family);
    font-size: var(--console-description-chip-size);
    font-style: var(--font-accent--style);
    font-weight: 500;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .console-description__chip--highlight {
    border-color: transparent;
    background: var(--console-description-chip-active-bg, #241c40);
    color: var(--console-description-heading, #f1eefa);
    font-weight: 700;
  }

  .console-description__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.4rem;
    margin-block-start: 3.8rem;
    padding-block-start: 3.2rem;
    border-block-start: 1px solid var(--console-description-divider, rgb(76 201 240 / 18%));
  }

  .console-description__stat-value,
  .console-description__stat-label {
    margin: 0;
  }

  .console-description__stat-value {
    color: var(--console-description-heading, #f1eefa);
    font-family: var(--font-accent--family);
    font-size: var(--console-description-stat-size);
    font-style: var(--font-accent--style);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1;
    overflow-wrap: anywhere;
  }

  .console-description__stat-label {
    margin-block-start: 1rem;
    color: var(--console-description-muted, #9b92b8);
    font-size: calc(var(--console-description-text-size) - 2px);
    line-height: 1.35;
  }

  .console-description__media {
    grid-area: media;
    margin: 0;
    justify-self: center;
    width: 100%;
    max-width: 100%;
  }

  .console-description__image {
    display: block;
    width: 100%;
    max-height: var(--console-description-image-max-height);
    aspect-ratio: var(--console-description-image-ratio);
    object-fit: var(--console-description-image-fit);
    background: var(--console-description-image-background, transparent);
    border: var(--console-description-image-border-width) solid var(--console-description-image-border, #f1eefa);
    border-radius: var(--console-description-image-radius);
    height: auto;
  }

  .console-description__image--placeholder {
    background: rgb(255 255 255 / 4%);
  }

  .console-description__caption {
    margin-block-start: 0.9rem;
    color: var(--console-description-muted, #9b92b8);
    font-size: calc(var(--console-description-text-size) - 2px);
    line-height: 1.35;
  }

  @media screen and (max-width: 989px) {
    .console-description__inner,
    .console-description--image-left .console-description__inner {
      grid-template-columns: 1fr;
      grid-template-areas: 'content' 'media';
      gap: 3.2rem;
    }

    .console-description__heading {
      font-size: var(--console-description-heading-size-mobile);
    }

    .console-description__stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.6rem;
    }

    .console-description__media {
      max-width: min(100%, 56rem);
    }

    .console-description__image {
      max-height: min(var(--console-description-image-max-height), 64rem);
    }
  }

  @media screen and (max-width: 749px) {
    .console-description__text {
      font-size: min(var(--console-description-text-size), 1.6rem);
    }

    .console-description__chips {
      gap: 0.7rem;
      margin-block-start: 2.4rem;
    }

    .console-description__chip {
      min-height: 3rem;
      padding: 0.45rem 1rem;
      font-size: min(var(--console-description-chip-size), 1.4rem);
    }

    .console-description__stats {
      grid-template-columns: 1fr;
      gap: 1.8rem;
      margin-block-start: 3rem;
      padding-block-start: 2.4rem;
    }

    .console-description__stat-value {
      font-size: min(var(--console-description-stat-size), 3.4rem);
    }

    .console-description__stat-label,
    .console-description__caption {
      font-size: min(calc(var(--console-description-text-size) - 2px), 1.4rem);
    }
  }

  @media screen and (max-width: 479px) {
    .console-description__heading {
      font-size: min(var(--console-description-heading-size-mobile), 3.4rem);
    }

    .console-description__media {
      justify-self: stretch;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Descripcion de consolas",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "console",
