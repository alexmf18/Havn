          "default": "20 000"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Etiqueta",
          "default": "juegos preinstalados"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titulo",
      "default": "Once consolas, una sola caja"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Cada emulador llega instalado y probado. Los juegos ya estan dentro, ordenados por sistema.</p>"
    },
    {
