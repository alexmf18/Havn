{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<section
  class="retro-features section section--{{ section.settings.section_width }} spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --retro-features-surface: {{ section.settings.surface_color }};
    --retro-features-border: {{ section.settings.border_color }};
    --retro-features-label: {{ section.settings.label_color }};
    --retro-features-heading: {{ section.settings.heading_color }};
    --retro-features-text: {{ section.settings.text_color }};
  "
>
  <div class="retro-features__grid">
    {%- for block in section.blocks -%}
      <article
        class="retro-features__item"
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.label != blank -%}
          <p class="retro-features__label">{{ block.settings.label | escape }}</p>
        {%- endif -%}

        {%- if block.settings.heading != blank -%}
          <h2 class="retro-features__heading">{{ block.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if block.settings.text != blank -%}
          <div class="retro-features__text">
            {{ block.settings.text }}
          </div>
        {%- endif -%}
      </article>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .retro-features {
    background: var(--color-background, transparent);
    color: var(--retro-features-heading, #f1eefa);
  }

  .retro-features__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid var(--retro-features-border, rgb(76 201 240 / 18%));
    background: var(--retro-features-surface, #151827);
  }

  .retro-features__item {
    min-width: 0;
    padding: clamp(2.4rem, 4vw, 4.8rem) clamp(1.6rem, 3vw, 3.2rem);
  }

  .retro-features__item + .retro-features__item {
    border-inline-start: 1px solid var(--retro-features-border, rgb(76 201 240 / 18%));
  }

  .retro-features__label {
    margin: 0 0 1.1rem;
    color: var(--retro-features-label, #9b92b8);
    font-family: var(--font-accent--family);
    font-size: clamp(1.2rem, 1.1vw, 1.4rem);
    font-style: var(--font-accent--style);
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .retro-features__heading {
    margin: 0;
    color: var(--retro-features-heading, #f1eefa);
    font-family: var(--font-primary--family);
    font-size: clamp(4rem, 6vw, 6.4rem);
    font-style: var(--font-primary--style);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 0.95;
  }

  .retro-features__text {
    margin-block-start: 1.3rem;
    max-width: 34rem;
    color: var(--retro-features-text, #c9c4d8);
    font-family: var(--font-body--family);
    font-size: clamp(1.5rem, 1.4vw, 1.8rem);
    line-height: 1.45;
  }

  .retro-features__text > * {
    margin: 0;
  }

  .retro-features__text > * + * {
    margin-block-start: 0.8rem;
  }

  @media screen and (max-width: 989px) {
    .retro-features__grid {
      grid-template-columns: 1fr;
    }

    .retro-features__item + .retro-features__item {
      border-block-start: 1px solid var(--retro-features-border, rgb(76 201 240 / 18%));
      border-inline-start: 0;
    }

    .retro-features__item {
      padding-inline: var(--page-margin);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Caracteristicas retro",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 3,
  "blocks": [
    {
      "type": "feature",
      "name": "Caracteristica",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Etiqueta",
          "default": "PANTALLA"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Titulo",
          "default": "720x720"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "default": "<p>IPS de 4 pulgadas laminada en optica. Pixeles limpios, color estable y juego nitido.</p>"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho",
      "options": [
        {
          "value": "page-width",
          "label": "Pagina"
        },
        {
          "value": "full-width",
          "label": "Completo"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#1B1533"
    },
    {
      "type": "color",
      "id": "surface_color",
      "label": "Color de superficie",
      "default": "#151827"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Color de divisores",
      "alpha": true,
      "default": "#4CC9F033"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Color de etiqueta",
      "default": "#9B92B8"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color de titulo",
      "default": "#F1EEFA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color de texto",
      "default": "#C9C4D8"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Superior",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Inferior",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Caracteristicas retro",
      "category": "Texto",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "label": "PANTALLA",
            "heading": "720x720",
            "text": "<p>IPS de 4 pulgadas laminada en optica. Los pixeles de 1990 se ven como se veian: cuadrados y limpios.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "label": "BATERIA",
            "heading": "8 horas",
            "text": "<p>3000 mAh y extraible: se cambia sin herramientas y se ve la carga por fuera.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "label": "MANDOS",
            "heading": "2 · RGB",
            "text": "<p>Joysticks 3D con anillo de siete colores, gatillos mecanicos y cruceta de verdad.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
