{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<footer
  class="retro-footer section section--{{ section.settings.section_width }} spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --retro-footer-heading: {{ section.settings.heading_color }};
    --retro-footer-text: {{ section.settings.text_color }};
    --retro-footer-muted: {{ section.settings.muted_color }};
    --retro-footer-border: {{ section.settings.border_color }};
    --retro-footer-logo-size: {{ section.settings.logo_size }}px;
    --retro-footer-heading-size: {{ section.settings.heading_size }}px;
    --retro-footer-link-size: {{ section.settings.link_size }}px;
    --retro-footer-gap: {{ section.settings.column_gap }}px;
  "
>
  <div class="retro-footer__inner">
    <div class="retro-footer__brand">
      {%- if section.settings.logo != blank -%}
        {{
          section.settings.logo
          | image_url: width: 400
          | image_tag:
            widths: '120, 200, 300, 400',
            sizes: '200px',
            alt: section.settings.logo.alt,
            loading: 'lazy',
            class: 'retro-footer__logo-image'
        }}
      {%- elsif section.settings.logo_text != blank -%}
        <p class="retro-footer__logo-text">{{ section.settings.logo_text | escape }}</p>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="retro-footer__text">
          {{ section.settings.text }}
        </div>
      {%- endif -%}
    </div>

    <nav class="retro-footer__menus" aria-label="{{ section.settings.navigation_label | escape }}">
      {%- for block in section.blocks -%}
        <div
          class="retro-footer__menu"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.heading != blank -%}
            <h2 class="retro-footer__menu-heading">{{ block.settings.heading | escape }}</h2>
          {%- endif -%}

          <ul class="retro-footer__links" role="list">
            {%- for i in (1..4) -%}
              {%- liquid
                assign label_key = 'link_' | append: i | append: '_label'
                assign url_key = 'link_' | append: i | append: '_url'
                assign link_label = block.settings[label_key]
                assign link_url = block.settings[url_key]
              -%}

              {%- if link_label != blank -%}
                <li>
                  <a href="{% if link_url != blank %}{{ link_url }}{% else %}#{% endif %}">
                    {{ link_label | escape }}
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </nav>
  </div>
</footer>

{% stylesheet %}
  .retro-footer {
    background: var(--color-background, transparent);
    border-block-start: 1px solid var(--retro-footer-border, rgb(76 201 240 / 18%));
  }

  .retro-footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--retro-footer-gap);
    align-items: start;
  }

  .retro-footer__brand {
    min-width: 0;
  }

  .retro-footer__logo-image {
    display: block;
    width: var(--retro-footer-logo-size);
    max-width: 100%;
    height: auto;
  }

  .retro-footer__logo-text {
    margin: 0;
    color: var(--retro-footer-heading, #f1eefa);
    font-family: var(--font-accent--family);
    font-size: var(--retro-footer-heading-size);
    font-style: var(--font-accent--style);
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .retro-footer__text {
    max-width: 38rem;
    margin-block-start: 0.8rem;
    color: var(--retro-footer-muted, #9b92b8);
    font-size: var(--retro-footer-link-size);
    line-height: 1.45;
  }

  .retro-footer__text > * {
    margin: 0;
  }

  .retro-footer__menus {
    display: grid;
    grid-template-columns: repeat(3, minmax(10rem, 1fr));
    gap: 7.2rem;
    min-width: min(48rem, 100%);
  }

  .retro-footer__menu-heading {
    margin: 0 0 1rem;
    color: var(--retro-footer-heading, #f1eefa);
    font-family: var(--font-accent--family);
    font-size: var(--retro-footer-link-size);
    font-style: var(--font-accent--style);
    font-weight: 700;
    line-height: 1.25;
  }

  .retro-footer__links {
    display: grid;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
  }

  .retro-footer__links li {
    list-style: none;
  }

  .retro-footer__links a {
    color: var(--retro-footer-muted, #9b92b8);
    font-size: var(--retro-footer-link-size);
    line-height: 1.25;
    text-decoration: none;
  }

  .retro-footer__links a:hover {
    color: var(--retro-footer-text, #f1eefa);
  }

  @media screen and (max-width: 749px) {
    .retro-footer__inner {
      grid-template-columns: 1fr;
      gap: 3.2rem;
    }

    .retro-footer__menus {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.4rem;
      min-width: 0;
    }

    .retro-footer__text,
    .retro-footer__links a,
    .retro-footer__menu-heading {
      font-size: min(var(--retro-footer-link-size), 1.4rem);
    }
  }

  @media screen and (max-width: 479px) {
    .retro-footer__menus {
      grid-template-columns: 1fr;
      gap: 2.2rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer retro",
  "enabled_on": {
    "groups": ["footer"]
  },
  "max_blocks": 3,
  "blocks": [
    {
      "type": "menu_column",
      "name": "Menu vertical",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Titulo",
          "default": "Tienda"
        },
        {
          "type": "text",
          "id": "link_1_label",
          "label": "Enlace 1",
          "default": "La consola"
        },
        {
          "type": "url",
          "id": "link_1_url",
          "label": "URL enlace 1"
        },
        {
          "type": "text",
          "id": "link_2_label",
          "label": "Enlace 2",
          "default": "Juegos incluidos"
        },
        {
          "type": "url",
          "id": "link_2_url",
          "label": "URL enlace 2"
        },
        {
          "type": "text",
          "id": "link_3_label",
          "label": "Enlace 3",
          "default": "Accesorios"
        },
        {
          "type": "url",
          "id": "link_3_url",
          "label": "URL enlace 3"
        },
        {
          "type": "text",
          "id": "link_4_label",
          "label": "Enlace 4"
        },
        {
          "type": "url",
          "id": "link_4_url",
          "label": "URL enlace 4"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Texto del logo",
      "default": "Modo Retro"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Tu infancia, en el bolsillo. Valencia, Espana.</p>"
    },
    {
      "type": "text",
      "id": "navigation_label",
      "label": "Etiqueta accesible de navegacion",
      "default": "Enlaces del footer"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho",
      "options": [
        {
          "value": "page-width",
          "label": "Pagina"
        },
        {
          "value": "full-width",
          "label": "Completo"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#1B1533"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color de titulos",
      "default": "#F1EEFA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color activo",
      "default": "#F1EEFA"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Color secundario",
      "default": "#9B92B8"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Color de borde",
      "alpha": true,
      "default": "#4CC9F033"
    },
    {
      "type": "header",
      "content": "Tamano"
    },
    {
      "type": "range",
      "id": "logo_size",
      "label": "Ancho del logo",
      "min": 80,
      "max": 260,
      "step": 4,
      "unit": "px",
      "default": 140
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamano del logo de texto",
      "min": 13,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "link_size",
      "label": "Tamano de enlaces",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Separacion de columnas",
      "min": 24,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Superior",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Inferior",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "Footer retro",
      "category": "Footer",
      "blocks": [
        {
          "type": "menu_column",
          "settings": {
            "heading": "Tienda",
            "link_1_label": "La consola",
            "link_2_label": "Juegos incluidos",
            "link_3_label": "Accesorios"
          }
        },
        {
          "type": "menu_column",
          "settings": {
            "heading": "Ayuda",
            "link_1_label": "Envios",
            "link_2_label": "Devoluciones",
            "link_3_label": "Contacto"
          }
        },
        {
          "type": "menu_column",
          "settings": {
            "heading": "Legal",
            "link_1_label": "Aviso legal",
            "link_2_label": "Privacidad",
            "link_3_label": "Cookies"
          }
        }
      ]
    }
  ]
}
{% endschema %}
