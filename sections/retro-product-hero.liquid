{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_kicker = section.settings.kicker

  if product_kicker == blank and product.vendor != blank
    assign product_kicker = product.vendor
  endif

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<section
  class="retro-product-page section section--{{ section.settings.section_width }} spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --retro-product-page-bg: {{ section.settings.background_color }};
    --retro-product-page-hero-bg: {{ section.settings.hero_panel_color }};
    --retro-product-page-panel: {{ section.settings.panel_color }};
    --retro-product-page-text: {{ section.settings.text_color }};
    --retro-product-page-dark-text: {{ section.settings.dark_text_color }};
    --retro-product-page-muted: {{ section.settings.muted_color }};
    --retro-product-page-light-muted: {{ section.settings.light_muted_color }};
    --retro-product-page-heading: {{ section.settings.heading_color }};
    --retro-product-page-border: {{ section.settings.border_color }};
    --retro-product-page-accent: {{ section.settings.accent_color }};
    --retro-product-page-button-bg: {{ section.settings.button_background_color }};
    --retro-product-page-button-text: {{ section.settings.button_text_color }};
    --retro-product-page-heading-size: {{ section.settings.heading_size }}px;
    --retro-product-page-heading-mobile: {{ section.settings.heading_size_mobile }}px;
    --retro-product-page-text-size: {{ section.settings.text_size }}px;
    --retro-product-page-price-size: {{ section.settings.price_size }}px;
    --retro-product-page-image-size: {{ section.settings.image_size }}%;
    --retro-product-page-image-fit: {{ section.settings.image_fit }};
    --retro-product-page-image-ratio: {{ section.settings.image_ratio }};
    --retro-product-page-sidebar-width: {{ section.settings.sidebar_width }}px;
    --retro-product-page-gap: {{ section.settings.column_gap }}px;
  "
>
  <div class="retro-product-page__layout">
    <div class="retro-product-page__main">
      <div class="retro-product-page__intro">
        <div class="retro-product-page__product-shot">
          {%- if product.featured_image != blank -%}
            {{
              product.featured_image
              | image_url: width: section.settings.image_resolution
              | image_tag:
                widths: '360, 533, 720, 900, 1200, 1600, 2048',
                sizes: '(min-width: 990px) 34vw, 78vw',
                alt: product.featured_image.alt,
                loading: 'eager',
                class: 'retro-product-page__image'
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'retro-product-page__image retro-product-page__placeholder' }}
          {%- endif -%}
        </div>

        <div class="retro-product-page__copy">
          {%- if product_kicker != blank -%}
            <p class="retro-product-page__kicker">{{ product_kicker | escape }}</p>
          {%- endif -%}

          <h1 class="retro-product-page__title">
            {%- if section.settings.display_heading != blank -%}
              {{ section.settings.display_heading | escape }}
            {%- else -%}
              {{ product.title | escape }}
            {%- endif -%}
          </h1>

          {%- if section.settings.display_text != blank -%}
            <div class="retro-product-page__lead">
              {{ section.settings.display_text }}
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- if section.settings.show_process -%}
        <div class="retro-product-page__section">
          <h2 class="retro-product-page__section-title">{{ section.settings.process_heading | escape }}</h2>
          <div class="retro-product-page__process">
            <article class="retro-product-page__process-item">
              <p>{{ section.settings.step_one_label | escape }}</p>
              <h3>{{ section.settings.step_one_title | escape }}</h3>
              <div>{{ section.settings.step_one_text }}</div>
            </article>
            <article class="retro-product-page__process-item">
              <p>{{ section.settings.step_two_label | escape }}</p>
              <h3>{{ section.settings.step_two_title | escape }}</h3>
              <div>{{ section.settings.step_two_text }}</div>
            </article>
            <article class="retro-product-page__process-item">
              <p>{{ section.settings.step_three_label | escape }}</p>
              <h3>{{ section.settings.step_three_title | escape }}</h3>
              <div>{{ section.settings.step_three_text }}</div>
            </article>
            <article class="retro-product-page__process-item">
              <p>{{ section.settings.step_four_label | escape }}</p>
              <h3>{{ section.settings.step_four_title | escape }}</h3>
              <div>{{ section.settings.step_four_text }}</div>
            </article>
          </div>
        </div>
      {%- endif -%}
    </div>

    <aside class="retro-product-page__sidebar" aria-label="{{ section.settings.purchase_panel_label | escape }}">
      <div class="retro-product-page__purchase">
        <p class="retro-product-page__eyebrow">{{ product_kicker | escape }}</p>
        <h2 class="retro-product-page__purchase-title">{{ product.title | escape }}</h2>

        <div class="retro-product-page__price-row">
          <span class="retro-product-page__price">{{ current_variant.price | money }}</span>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="retro-product-page__compare">{{ current_variant.compare_at_price | money }}</span>
          {%- endif -%}
        </div>

        {%- if section.settings.tax_text != blank -%}
          <p class="retro-product-page__tax">{{ section.settings.tax_text | escape }}</p>
        {%- endif -%}

        {%- if section.settings.show_description and product.description != blank -%}
          <div class="retro-product-page__description-panel">
            <p class="retro-product-page__description-label">{{ section.settings.description_label | escape }}</p>
            <div class="retro-product-page__description-copy">
              {{ product.description }}
            </div>
          </div>
        {%- endif -%}

        {%- form 'product', product, class: 'retro-product-page__form' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">

          {%- if section.settings.show_quantity -%}
            <label class="retro-product-page__quantity">
              <span>{{ section.settings.quantity_label | escape }}</span>
              <input
                type="number"
                name="quantity"
                value="1"
                min="1"
                {% if current_variant.inventory_management and current_variant.inventory_policy == 'deny' %}
                  max="{{ current_variant.inventory_quantity }}"
                {% endif %}
              >
            </label>
          {%- endif -%}

          <button
            class="retro-product-page__button"
            type="submit"
            {% unless product.available %}
              disabled
            {% endunless %}
          >
            {%- if product.available -%}
              {{ section.settings.button_label | escape }}
            {%- else -%}
              {{ section.settings.sold_out_button_label | escape }}
            {%- endif -%}
          </button>

          {%- if section.settings.show_dynamic_checkout -%}
            <div class="retro-product-page__dynamic-checkout">
              {{ form | payment_button }}
            </div>
          {%- endif -%}
        {%- endform -%}

        {%- if section.settings.note != blank -%}
          <div class="retro-product-page__note">
            {{ section.settings.note }}
          </div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="retro-product-page__badges" aria-label="{{ section.settings.badges_label | escape }}">
            {%- for block in section.blocks -%}
              <span class="retro-product-page__badge" {{ block.shopify_attributes }}>
                {{ block.settings.text | escape }}
              </span>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </aside>
  </div>
</section>

{% stylesheet %}
  .retro-product-page {
    background: var(--color-background, var(--retro-product-page-bg, #10111e));
    color: var(--retro-product-page-text, #f1eefa);
  }

  .retro-product-page__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, var(--retro-product-page-sidebar-width));
    gap: var(--retro-product-page-gap);
    align-items: start;
  }

  .retro-product-page__intro {
    display: grid;
    grid-template-columns: minmax(180px, 0.72fr) minmax(0, 1fr);
    gap: 4rem;
    align-items: center;
    min-height: 52rem;
    padding: 5.6rem;
    background: var(--retro-product-page-hero-bg, #dce2f4);
    color: var(--retro-product-page-dark-text, #1b1533);
  }

  .retro-product-page__product-shot {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
  }

  .retro-product-page__image {
    display: block;
    width: var(--retro-product-page-image-size);
    max-width: 100%;
    aspect-ratio: var(--retro-product-page-image-ratio);
    object-fit: var(--retro-product-page-image-fit);
    filter: drop-shadow(0 2.8rem 3.4rem rgb(27 21 51 / 28%));
  }

  .retro-product-page__placeholder {
    background: rgb(255 255 255 / 30%);
  }

  .retro-product-page__copy {
    max-width: 48rem;
  }

  .retro-product-page__kicker,
  .retro-product-page__eyebrow,
  .retro-product-page__description-label,
  .retro-product-page__process-item p {
    margin: 0;
    font-family: var(--font-accent--family);
    font-size: 1.1rem;
    font-style: var(--font-accent--style);
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .retro-product-page__kicker {
    margin-block-end: 1.4rem;
    color: var(--retro-product-page-accent, #4cc9f0);
  }

  .retro-product-page__title {
    max-width: 10em;
    margin: 0;
    color: var(--retro-product-page-dark-text, #1b1533);
    font-family: var(--font-primary--family);
    font-size: var(--retro-product-page-heading-size);
    font-style: var(--font-primary--style);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 0.98;
  }

  .retro-product-page__lead {
    max-width: 44rem;
    margin-block-start: 1.8rem;
    color: var(--retro-product-page-light-muted, #505165);
    font-size: var(--retro-product-page-text-size);
    line-height: 1.55;
  }

  .retro-product-page__lead > *,
  .retro-product-page__note > *,
  .retro-product-page__process-item div > * {
    margin: 0;
  }

  .retro-product-page__section {
    padding: 4rem 0 0;
  }

  .retro-product-page__section-title {
    margin: 0 0 2rem;
    color: var(--retro-product-page-heading, #f1eefa);
    font-family: var(--font-primary--family);
    font-size: 2.8rem;
    font-style: var(--font-primary--style);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.1;
  }

  .retro-product-page__process {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.6rem;
  }

  .retro-product-page__process-item {
    min-width: 0;
    padding-block-start: 1.6rem;
    border-block-start: 1px solid var(--retro-product-page-border, rgb(76 201 240 / 20%));
  }

  .retro-product-page__process-item p {
    color: var(--retro-product-page-muted, #9b92b8);
  }

  .retro-product-page__process-item h3 {
    margin: 0.7rem 0 0.7rem;
    color: var(--retro-product-page-heading, #f1eefa);
    font-family: var(--font-accent--family);
    font-size: 1.6rem;
    font-style: var(--font-accent--style);
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.2;
  }

  .retro-product-page__process-item div {
    color: var(--retro-product-page-muted, #9b92b8);
    font-size: 1.4rem;
    line-height: 1.45;
  }

  .retro-product-page__sidebar {
    position: sticky;
    inset-block-start: 1.6rem;
  }

  .retro-product-page__purchase {
    padding: 2rem;
    border-inline-start: 1px solid var(--retro-product-page-border, rgb(76 201 240 / 22%));
    background: var(--retro-product-page-panel, #11111f);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 5%);
  }

  .retro-product-page__eyebrow {
    color: var(--retro-product-page-muted, #9b92b8);
  }

  .retro-product-page__purchase-title {
    margin: 0.8rem 0 1.2rem;
    color: var(--retro-product-page-heading, #f1eefa);
    font-family: var(--font-accent--family);
    font-size: 1.6rem;
    font-style: var(--font-accent--style);
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.2;
  }

  .retro-product-page__price-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    align-items: baseline;
  }

  .retro-product-page__price {
    color: var(--retro-product-page-heading, #f1eefa);
    font-family: var(--font-accent--family);
    font-size: var(--retro-product-page-price-size);
    font-style: var(--font-accent--style);
    font-weight: 800;
    line-height: 1;
  }

  .retro-product-page__compare {
    color: var(--retro-product-page-muted, #9b92b8);
    font-size: 1.3rem;
    text-decoration: line-through;
  }

  .retro-product-page__tax {
    margin: 0.7rem 0 1.6rem;
    color: var(--retro-product-page-muted, #9b92b8);
    font-size: 1.2rem;
    line-height: 1.35;
  }

  .retro-product-page__description-panel {
    margin-block: 1.6rem;
    padding: 1.4rem;
    border: 1px solid var(--retro-product-page-accent, #4cc9f0);
    border-radius: 0.4rem;
    background: rgb(27 21 51 / 38%);
  }

  .retro-product-page__description-label {
    margin-block-end: 0.9rem;
    color: var(--retro-product-page-accent, #4cc9f0);
  }

  .retro-product-page__description-copy {
    display: -webkit-box;
    max-height: 14rem;
    overflow: hidden;
    color: var(--retro-product-page-muted, #9b92b8);
    font-size: 1.3rem;
    line-height: 1.45;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 6;
  }

  .retro-product-page__description-copy > * {
    margin: 0;
  }

  .retro-product-page__description-copy > * + * {
    margin-block-start: 0.8rem;
  }

  .retro-product-page__form {
    display: grid;
    gap: 1rem;
  }

  .retro-product-page__quantity {
    display: grid;
    gap: 0.6rem;
    color: var(--retro-product-page-muted, #9b92b8);
    font-family: var(--font-accent--family);
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .retro-product-page__quantity input,
  .retro-product-page__button {
    width: 100%;
    min-height: 4.6rem;
    border-radius: 0.4rem;
    font-family: var(--font-accent--family);
    font-style: var(--font-accent--style);
    font-weight: 800;
  }

  .retro-product-page__quantity input {
    padding: 0.8rem 1rem;
    border: 1px solid var(--retro-product-page-border, rgb(76 201 240 / 28%));
    background: transparent;
    color: var(--retro-product-page-heading, #f1eefa);
  }

  .retro-product-page__button {
    border: 1px solid var(--retro-product-page-button-bg, #ff7a45);
    background: var(--retro-product-page-button-bg, #ff7a45);
    color: var(--retro-product-page-button-text, #1b1533);
    cursor: pointer;
    font-size: 1.4rem;
    transition:
      transform 160ms ease,
      opacity 160ms ease;
  }

  .retro-product-page__button:hover {
    opacity: 0.94;
    transform: translateY(-1px);
  }

  .retro-product-page__button:disabled {
    cursor: not-allowed;
    opacity: 0.55;
    transform: none;
  }

  .retro-product-page__dynamic-checkout .shopify-payment-button__button {
    min-height: 4.4rem;
    border-radius: 0.4rem;
  }

  .retro-product-page__note {
    margin-block-start: 1.6rem;
    color: var(--retro-product-page-muted, #9b92b8);
    font-size: 1.2rem;
    line-height: 1.45;
  }

  .retro-product-page__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-block-start: 1.6rem;
  }

  .retro-product-page__badge {
    display: inline-flex;
    align-items: center;
    min-height: 2.2rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--retro-product-page-border, rgb(76 201 240 / 26%));
    border-radius: 0.3rem;
    color: var(--retro-product-page-heading, #f1eefa);
    font-family: var(--font-accent--family);
    font-size: 1rem;
    font-style: var(--font-accent--style);
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
  }

  .retro-product-page__button:focus-visible,
  .retro-product-page__quantity input:focus-visible {
    outline: 2px solid var(--retro-product-page-accent, #4cc9f0);
    outline-offset: 3px;
  }

  @media screen and (max-width: 989px) {
    .retro-product-page__layout {
      grid-template-columns: 1fr;
    }

    .retro-product-page__sidebar {
      position: static;
    }

    .retro-product-page__purchase {
      border: 1px solid var(--retro-product-page-border, rgb(76 201 240 / 22%));
    }
  }

  @media screen and (max-width: 749px) {
    .retro-product-page__intro {
      grid-template-columns: 1fr;
      gap: 2.8rem;
      min-height: 0;
      padding: 3.2rem 2rem;
    }

    .retro-product-page__title {
      font-size: var(--retro-product-page-heading-mobile);
    }

    .retro-product-page__lead {
      font-size: min(var(--retro-product-page-text-size), 1.5rem);
    }

    .retro-product-page__process {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Producto retro",
  "enabled_on": {
    "templates": ["product"]
  },
  "blocks": [
    {
      "type": "badge",
      "name": "Etiqueta inferior",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "720x720 IPS"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Etiqueta superior",
      "default": "El regalo que se enciende solo"
    },
    {
      "type": "text",
      "id": "display_heading",
      "label": "Titulo principal",
      "default": "Veinte mil juegos, envueltos"
    },
    {
      "type": "richtext",
      "id": "display_text",
      "label": "Texto principal",
      "default": "<p>La R36 Ultra llega cargada, con la tarjeta puesta y el menu en espanol. Quien la recibe solo tiene que darle al boton.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Mostrar descripcion en el panel de compra",
      "default": true
    },
    {
      "type": "text",
      "id": "description_label",
      "label": "Titulo de descripcion",
      "default": "Descripcion del producto"
    },
    {
      "type": "text",
      "id": "purchase_panel_label",
      "label": "Etiqueta accesible del panel",
      "default": "Compra del producto"
    },
    {
      "type": "text",
      "id": "tax_text",
      "label": "Texto bajo precio",
      "default": "IVA incluido. Envio calculado en el checkout."
    },
    {
      "type": "text",
      "id": "badges_label",
      "label": "Etiqueta accesible de pagos",
      "default": "Metodos y detalles"
    },
    {
      "type": "text",
      "id": "quantity_label",
      "label": "Etiqueta cantidad",
      "default": "Cantidad"
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Mostrar cantidad",
      "default": false
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del boton",
      "default": "Anadir al carrito"
    },
    {
      "type": "text",
      "id": "sold_out_button_label",
      "label": "Texto del boton agotado",
      "default": "Sin stock"
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Mostrar boton de pago acelerado",
      "default": true
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "Nota bajo botones",
      "default": "<p>Envio gratis en peninsula 24-48 h. Garantia de 2 anos. 30 dias para devolverla.</p>"
    },
    {
      "type": "header",
      "content": "Bloque como va a ir la cosa"
    },
    {
      "type": "checkbox",
      "id": "show_process",
      "label": "Mostrar pasos",
      "default": true
    },
    {
      "type": "text",
      "id": "process_heading",
      "label": "Titulo pasos",
      "default": "Como va a ir la cosa"
    },
    {
      "type": "text",
      "id": "step_one_label",
      "label": "Paso 1 etiqueta",
      "default": "Paso 01"
    },
    {
      "type": "text",
      "id": "step_one_title",
      "label": "Paso 1 titulo",
      "default": "Lo pides hoy"
    },
    {
      "type": "richtext",
      "id": "step_one_text",
      "label": "Paso 1 texto",
      "default": "<p>Antes de las 15:00 sale el mismo dia. Envio gratis y con factura dentro de la caja.</p>"
    },
    {
      "type": "text",
      "id": "step_two_label",
      "label": "Paso 2 etiqueta",
      "default": "Paso 02"
    },
    {
      "type": "text",
      "id": "step_two_title",
      "label": "Paso 2 titulo",
      "default": "Llega envuelta"
    },
    {
      "type": "richtext",
      "id": "step_two_text",
      "label": "Paso 2 texto",
      "default": "<p>Caja de regalo, cinta y una tarjeta con el mensaje que nos escribas.</p>"
    },
    {
      "type": "text",
      "id": "step_three_label",
      "label": "Paso 3 etiqueta",
