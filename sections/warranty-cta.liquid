{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<section
  class="warranty-cta section section--{{ section.settings.section_width }} spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --warranty-cta-panel: {{ section.settings.panel_color }};
    --warranty-cta-border: {{ section.settings.border_color }};
    --warranty-cta-heading: {{ section.settings.heading_color }};
    --warranty-cta-text: {{ section.settings.text_color }};
    --warranty-cta-button-text: {{ section.settings.button_text_color }};
    --warranty-cta-button-bg: {{ section.settings.button_background_color }};
    --warranty-cta-button-border: {{ section.settings.button_border_color }};
    --warranty-cta-heading-size: {{ section.settings.heading_size }}px;
    --warranty-cta-text-size: {{ section.settings.text_size }}px;
    --warranty-cta-button-size: {{ section.settings.button_text_size }}px;
  "
>
  <div class="warranty-cta__inner">
    <div class="warranty-cta__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="warranty-cta__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="warranty-cta__text">
          {{ section.settings.text }}
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <a
        class="warranty-cta__button"
        href="{{ section.settings.button_link }}"
        {% if section.settings.open_in_new_tab %}
          target="_blank" rel="noopener"
        {% endif %}
      >
        {{ section.settings.button_label | escape }}
      </a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .warranty-cta {
    background: var(--color-background, transparent);
  }

  .warranty-cta__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 3.2rem;
    align-items: center;
    min-height: 17.2rem;
    padding: clamp(2.8rem, 4vw, 4.8rem);
    border-block: 1px solid var(--warranty-cta-border, rgb(76 201 240 / 18%));
    background: var(--warranty-cta-panel, transparent);
  }

  .warranty-cta__heading {
    max-width: 19em;
    margin: 0;
    color: var(--warranty-cta-heading, #f1eefa);
    font-family: var(--font-primary--family);
    font-size: var(--warranty-cta-heading-size);
    font-style: var(--font-primary--style);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.15;
  }

  .warranty-cta__text {
    max-width: 55rem;
    margin-block-start: 0.8rem;
    color: var(--warranty-cta-text, #c9c4d8);
    font-size: var(--warranty-cta-text-size);
    line-height: 1.45;
  }

  .warranty-cta__text > * {
    margin: 0;
  }

  .warranty-cta__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 21.4rem;
    min-height: 4.6rem;
    padding: 1rem 2.4rem;
    border: 1px solid var(--warranty-cta-button-border, #a99bff);
    border-radius: 0.6rem;
    background: var(--warranty-cta-button-bg, transparent);
    color: var(--warranty-cta-button-text, #a99bff);
    font-family: var(--font-accent--family);
    font-size: var(--warranty-cta-button-size);
    font-style: var(--font-accent--style);
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
  }

  .warranty-cta__button:hover {
    opacity: 0.86;
  }

  @media screen and (max-width: 749px) {
    .warranty-cta__inner {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .warranty-cta__button {
      width: 100%;
      min-width: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Garantia y compra",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titulo",
      "default": "Garantia de 2 anos y 30 dias para pensarlo"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Si no encaja, la recogemos en tu casa y te devolvemos el importe completo. Sin preguntas y sin coste.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del boton",
      "default": "Anadir al carrito · 60 €"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del boton"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Abrir en una pestana nueva",
      "default": false
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho",
      "options": [
        {
          "value": "page-width",
          "label": "Pagina"
        },
        {
          "value": "full-width",
          "label": "Completo"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#1B1533"
    },
    {
      "type": "color",
      "id": "panel_color",
      "label": "Color del panel",
      "alpha": true,
      "default": "#241C4080"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Color de borde",
      "alpha": true,
      "default": "#4CC9F033"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color de titulo",
      "default": "#F1EEFA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color de texto",
      "default": "#C9C4D8"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Color de texto del boton",
      "default": "#A99BFF"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Fondo del boton",
      "alpha": true,
      "default": "#00000000"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Borde del boton",
      "default": "#A99BFF"
    },
    {
      "type": "header",
      "content": "Tipografia"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamano de titulo",
      "min": 24,
      "max": 56,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Tamano de texto",
      "min": 13,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_text_size",
      "label": "Tamano de boton",
      "min": 13,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Superior",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Inferior",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Garantia y compra",
      "category": "Texto",
      "settings": {
        "button_link": "/cart"
      }
    }
  ]
}
{% endschema %}
